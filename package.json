{
  "name": "helix-hold",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "qa": "node qa/check.mjs",
    "test": "node qa/simulation.mjs && node qa/revision.mjs && node qa/field-check.mjs && node qa/crown.mjs && node qa/coverage.mjs && node qa/crown-growth.mjs && node qa/render-pools.mjs",
    "test:geometry": "node qa/geometry.mjs",
    "trial:carrier": "node qa/carrier-trial.mjs",
    "study:sweep": "node qa/sweep-study.mjs",
    "trial:continuation": "node qa/continuation-trial.mjs",
    "study:stasis": "node qa/stasis-study.mjs",
    "test:stasis-repro": "node qa/stasis-repro.mjs",
    "trial:crown": "node qa/crown-trial.mjs",
    "study:crown-coverage": "node qa/crown-coverage-study.mjs",
    "study:crown-stasis": "node qa/crown-stasis-study.mjs",
    "study:crown-pilot": "node qa/crown-pilot-study.mjs",
    "trial:crown-growth": "node qa/crown-growth-trial.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "lucide-react": "^0.510.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.56.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
